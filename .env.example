# Neon connection string (Neon dashboard -> Connect -> copy)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Long random text that signs login sessions:  openssl rand -base64 32
AUTH_SECRET=
# One-time code you type at first logon (any text you choose)
SETUP_CODE=
# Protects the daily backup job:  openssl rand -base64 32
CRON_SECRET=
